// Constants read by job creation
private static final _JOB_DESCRIPTION = 'Build and publish custom Docker images'

pipeline {
	options {
		skipDefaultCheckout()
		timestamps()
		timeout(time: 2, unit: 'HOURS')
		buildDiscarder(logRotator(numToKeepStr:'5'))
		disableConcurrentBuilds(abortPrevious: true)
	}
	triggers {
		cron '@weekly'
	}
	// Use Kaniko for unprivileged image builds/pushes on Kubernetes-provisioned Jenkins agents.
	agent {
		kubernetes {
			yaml '''
apiVersion: v1
kind: Pod
spec:
  containers:
  - name: jnlp
    image: eclipsecbi/jiro-agent-ubuntu-2404:latest
  - name: kaniko
    image: gcr.io/kaniko-project/executor:debug
    command: ["/busybox/cat"]
    tty: true
    volumeMounts:
    - name: registry-credentials
      mountPath: /kaniko/.docker
  volumes:
  - name: registry-credentials
    secret:
      secretName: docker-hub-credentials
      items:
      - key: .dockerconfigjson
        path: config.json
'''
		}
	}
	stages {
		stage('Get Docker Files') {
			environment {
				GIT_BRANCH = "${scm.branches[0].name}"
				GIT_REPOSITORY = "${scm.userRemoteConfigs[0].url}"
			}
			steps {
				cleanWs()
				sh '''
					git clone --depth=1 --branch ${GIT_BRANCH} ${GIT_REPOSITORY} eclipse.platform.releng.aggregator
					git clone --depth=1 --branch ${GIT_BRANCH} https://github.com/eclipse-jdt/eclipse.jdt.core eclipse.jdt.core
				'''
			}
		}
		stage('Build and push Docker Images') {
			steps {
				script {
					parallel(
						'debian-swtnative': { buildAndPushImage('eclipse.platform.releng.aggregator/cje-production/dockerfiles/debian/swtnativebuild', 'eclipse/platformreleng-debian-swtnativebuild:12') },
						'debian-swtgtk3native': { buildAndPushImage('eclipse.platform.releng.aggregator/cje-production/dockerfiles/debian/swtgtk3nativebuild', 'eclipse/platformreleng-debian-swtgtk3nativebuild:10') },
						'centos9-gtk4': { buildAndPushImage('eclipse.platform.releng.aggregator/cje-production/dockerfiles/centos-gtk4-mutter/9-gtk4', 'eclipse/platformreleng-centos-gtk4-mutter:9') },
						'opensuse-gtk3': { buildAndPushImage('eclipse.platform.releng.aggregator/cje-production/dockerfiles/opensuse-gtk3-metacity/16-gtk3', 'eclipse/platformreleng-opensuse-gtk3-metacity:16') },
						'jikespg': { buildAndPushImage('eclipse.jdt.core/org.eclipse.jdt.core/docker/jikespg', 'eclipse/platformreleng-ubuntu-gtk3-metacity:jikespg') },
					failFast: false)
				}
			}
		}
	}
	post {
		unsuccessful {
			emailext body: "Container images used for testing eclipse platform - Build Unsuccessful. Please go to ${BUILD_URL}console and check the log",
			subject: "Container images - Build Unsuccessful", 
			to: "platform-releng-dev@eclipse.org",
			from:"genie.releng@eclipse.org"
		}
		always {
			cleanWs()
		}
	}
}

def buildAndPushImage(String contextDir, String imageId) {
	container('kaniko') {
		sh """
			/kaniko/executor \
				--context=${WORKSPACE}/${contextDir} \
				--dockerfile=${WORKSPACE}/${contextDir}/Dockerfile \
				--destination=${imageId} \
				--cache=true
		"""
	}
}
